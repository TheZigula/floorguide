# .env.example - owns the list of environment variable NAMES this project reads.
# Names only, never values. The real .env is git-ignored; secrets reach a deploy target through its dashboard, never a file.

# Backend - secrets (set as encrypted env vars in the App Platform component settings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Backend - configuration, not secret
# comma-separated browser origins; the Vercel origin is added in the App Platform env, never in code
CORS_ORIGINS=
# routing is classification, so this one stays small
ROUTER_MODEL=
# the drafted work order is not classification, so this one stays capable
AGENT_MODEL=
# optional; the platform does not inject it, and /health falls back to parsing .git/HEAD
GIT_SHA=

# Front end (set in the Vercel project env) - the public base URL of the backend
VITE_API_BASE=
